        <Label htmlFor="name">Name</Label>
        <Input id="name" name="name" required />
      </div>

      <Button type="submit" disabled={isLoading}>
        {isLoading ? "Creating..." : "Create {{pascalCase name}}"}
      </Button>
    </form>
  );
}
